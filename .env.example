# ==========================================
# SSTV TurboPNG Web Application 設定ファイル
# ==========================================

# Basic認証用（Webアクセス全体のパスワード保護）
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your_secure_password_here

# Flask セッション暗号化用シークレットキー（ランダムな文字列）
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_string

# 管理者ユーザーのメールアドレス（カンマ区切りで複数指定可）
ADMIN_EMAILS=admin@example.com

# 開発時にBasic認証を無効化する場合は '1' に設定（本番環境では設定不要または '0'）
DISABLE_BASIC_AUTH=0
